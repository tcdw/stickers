---
import Footer from "../components/Footer";
import PageWrapper from "../components/PageWrapper.astro";
import ColorPalette from "../components/pages/design/ColorPalette";

const palettes = [
  {
    title: "主色 / Primary",
    description: "站点里的冷调主视觉颜色，适合按钮、强调信息与高亮反馈。",
    colors: [
      { name: "Primary 50", token: "--color-primary-50", value: "#ecfdff" },
      { name: "Primary 100", token: "--color-primary-100", value: "#cef7ff" },
      { name: "Primary 200", token: "--color-primary-200", value: "#a3edfe" },
      { name: "Primary 300", token: "--color-primary-300", value: "#66dffc" },
      { name: "Primary 400", token: "--color-primary-400", value: "#1ec6f2" },
      { name: "Primary 500", token: "--color-primary-500", value: "#02a9d8" },
      { name: "Primary 600", token: "--color-primary-600", value: "#0585b5" },
      { name: "Primary 700", token: "--color-primary-700", value: "#0b6c93" },
      { name: "Primary 800", token: "--color-primary-800", value: "#135777" },
      { name: "Primary 900", token: "--color-primary-900", value: "#144965" },
      { name: "Primary 950", token: "--color-primary-950", value: "#072f45" },
    ],
  },
  {
    title: "辅助色 / Accent",
    description: "OC 服装与情绪点缀的暖调辅助色，适合提示、点缀和局部强调。",
    colors: [
      { name: "Accent 50", token: "--color-accent-50", value: "#fff7ed" },
      { name: "Accent 100", token: "--color-accent-100", value: "#ffeed4" },
      { name: "Accent 200", token: "--color-accent-200", value: "#ffd9a8" },
      { name: "Accent 300", token: "--color-accent-300", value: "#ffbd71" },
      { name: "Accent 400", token: "--color-accent-400", value: "#ffa453" },
      { name: "Accent 500", token: "--color-accent-500", value: "#fe7711" },
      { name: "Accent 600", token: "--color-accent-600", value: "#ef5c07" },
      { name: "Accent 700", token: "--color-accent-700", value: "#c64308" },
      { name: "Accent 800", token: "--color-accent-800", value: "#9d360f" },
      { name: "Accent 900", token: "--color-accent-900", value: "#7e2e10" },
      { name: "Accent 950", token: "--color-accent-950", value: "#441406" },
    ],
  },
];
---

<PageWrapper title="设计规范" description="雪乃碗站点视觉与贴纸图片设计规范。" showNavigation>
  <header class="container sm:px-6 lg:px-8">
    <div
      class="banner overflow-hidden sm:rounded-b-3xl md:rounded-b-4xl bg-muted px-6 py-8 sm:px-10 sm:py-12 lg:px-14 lg:py-16"
    >
      <div class="max-w-3xl space-y-5 mt-32">
        <div class="space-y-6">
          <h1 class="text-4xl font-bold text-foreground sm:text-5xl lg:text-6xl">设计规范</h1>
          <p class="text-base leading-relaxed text-muted-foreground sm:text-lg">
            这里整理了站点当前使用的主色、辅助色，以及贴纸导出时建议遵循的图片规范。颜色卡片支持直接点击复制 Hex。
          </p>
        </div>
      </div>
    </div>
  </header>
  <main class="container px-4 py-6 sm:px-6 sm:py-8 lg:px-8 lg:py-12 space-y-12">
    <section class="space-y-6">
      <h2 class="text-xl font-semibold text-foreground">调色盘 / Color Palette</h2>
      <ColorPalette client:load palettes={palettes} />
    </section>

    <section class="space-y-8">
      <div class="space-y-2">
        <h2 class="text-xl font-semibold text-foreground">贴纸导出规范 / Sticker Specs</h2>
        <p class="text-muted-foreground">单位均为逻辑像素（px）。源文件建议保留 2 倍图以防后期调整。</p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <!-- 基础尺寸 -->
        <div class="space-y-4">
          <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Canvas</h3>
          <dl class="space-y-4">
            <div>
              <dt class="sr-only">源文件尺寸</dt>
              <dd class="text-2xl font-mono text-foreground">1024 × 1024</dd>
              <dd class="text-sm text-muted-foreground mt-1">编辑源文件</dd>
            </div>
            <div>
              <dt class="sr-only">导出尺寸</dt>
              <dd class="text-2xl font-mono text-foreground">512 × 512</dd>
              <dd class="text-sm text-muted-foreground mt-1">最终产物</dd>
            </div>
          </dl>
        </div>

        <!-- 边距与白边 -->
        <div class="space-y-4">
          <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Metrics</h3>
          <dl class="space-y-4">
            <div>
              <dt class="font-medium text-foreground">白边 (Stroke)</dt>
              <dd class="text-sm text-muted-foreground mt-1">10px <code>#FFFFFF</code></dd>
            </div>
            <div>
              <dt class="font-medium text-foreground">标准内边距</dt>
              <dd class="text-sm text-muted-foreground mt-1">44px</dd>
            </div>
            <div>
              <dt class="font-medium text-foreground">紧凑内边距</dt>
              <dd class="text-sm text-muted-foreground mt-1">32px</dd>
            </div>
          </dl>
        </div>

        <!-- 备注 -->
        <div class="space-y-4">
          <h3 class="text-sm font-medium text-muted-foreground uppercase tracking-wider">Notes</h3>
          <ul class="text-sm text-muted-foreground space-y-3 leading-normal">
            <li>• 所有内边距数值均包含白边。若不做白边，请额外增加 10px 留白。</li>
            <li>• 避免关键元素（如眼睛、文字）贴近裁切边缘。</li>
            <li>• 导出格式推荐 WebP 或 PNG 32-bit。</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</PageWrapper>
